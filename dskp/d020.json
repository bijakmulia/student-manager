{"s":"ASAS PERTANIAN PPKI (LOW)","f":"KSSMKR","u":[["PERKEBUNAN","ALATAN DAN BAHAN",[["1.1 Mengenali alatan dan bahan",["1.1.2 Mengetahui fungsi dan kegunaan alatan dan bahan"]],["1.2 Mengaplikasi penggunaan alatan dan bahan",["1.2.1 Mengetahui cara penggunaan alatan dan bahan","1.2.2 Membezakan jenis alatan.","1.2.3 Membezakan jenis bahan."]],["1.3 Membersih dan menyimpan alatan",["1.3.1 Memastikan alatan dibersihkan dan disimpan di tempat yang selamat."]]]],["PERKEBUNAN","KEUSAHAWANAN",[["5.1 Memilih hasil yang boleh dituai",["5.1.1 Mengetahui sukatan dan timbangan mengikut hasil tanaman"]],["5.2 Menghasilkan produk daripada hasil tanaman",["5.2.1 Mengetahui proses menghasilkan produk daripada hasil tanaman."]],["5.3 Membungkus dan mengepek produk atau hasil tanaman",["5.3.1 Mengetahui kaedah membungkus dan mengepek produk atau hasil tanaman"]],["5.4 Menjual hasil",["5.4.1 Mengetahui cara menjual hasil tanaman"]]]],["PERKEBUNAN","PENANAMAN DAN PENJAGAAN TANAMAN",[["3.1 Menyemai biji benih",["3.1.1 Mengetahui cara menyemai biji benih"]],["3.2 Menyiram tanaman",["3.2.1 Mengetahui cara menyiram tanaman"]],["3.3 Merumpai",["3.3.1 Mengenal antara rumpai dan tanaman"]],["3.4 Membaja tanaman",["3.4.1 Mengetahui jenis baja","3.4.2 Mengetahui kaedah membaja tanaman"]]]],["PERKEBUNAN","PENUAIAN HASIL TANAMAN",[["4.1 Memilih hasil yang boleh dituai",["4.1.1 Mengenal dan memilih hasil tanaman yang boleh dituai"]],["4.2 Mengutip hasil tanaman",["4.2.1 Mengetahui cara mengutip hasil tuaian"]],["4.3 Membersihkan hasil tanaman",["4.3.1 Mengetahui cara membersihkan hasil tanaman"]]]],["PERKEBUNAN","PENYEDIAAN DAN KEBERSIHAN RUANG TANAMAN",[["2.1 Mengenal pasti ruang tanaman",["2.1.1 Mengecam ruang tanaman yang digunakan"]],["2.2 Membersihkan ruang tanaman",["2.2.1 Melakukan aktiviti kebersihan ruang tanaman"]]]]]}