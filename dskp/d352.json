{"s":"PVMA MEMBUAT PAKAIAN","f":"5","u":[["","Menghasilkan Pakaian Kontemporari",[["1.0 MENGHASILKAN PAKAIAN KONTEMPORARI",["1.1 Mengenal pasti pakaian kontemporari.","1.2 Mengambil ukuran badan.","1.3 Mendraf pola pakaian kontemporari.","1.4 Menggunting fabrik pakaian kontemporari","1.5 Menjahit pakaian kontemporari.","1.6 Mengacu badan / Suai badan.","1.7 Membuat kemasan akhir / kemas siapan."]]]],["","Menghasilkan Pakaian Kerja",[["2.0 MENGHASILKAN PAKAIAN KERJA",["2.1 Mengenal pasti pakaian kerja.","2.2 Mengambil ukuran badan.","2.3 Mendraf pola pakaian kerja.","2.4 Menggunting fabrik pakaian kerja.","2.5 Menjahit pakaian kerja.","2.6 Mengacu badan / Suai badan","2.7 Membuat kemasan akhir / kemas siapan."]]]],["","Menghasilkan Pakaian Korporat",[["3.0 MENGHASILKAN PAKAIAN KORPORAT",["3.1 Mengenal pasti pakaian korporat.","3.2 Mengambil ukuran badan.","3.3 Mendraf pola pakaian korporat","3.4 Menggunting fabrik pakaian korporat","3.5 Menjahit pakaian korporat.","3.6 Mengacu badan / Suai badan","3.7 Membuat kemasan akhir / kemas siapan."]]]],["","Menghasilkan Pakaian Sukan",[["4.0 MENGHASILKAN PAKAIAN SUKAN",["4.1 Mengenal pasti pakaian sukan.","4.2 Mengambil ukuran badan.","4.3 Mendraf pola pakaian sukan","4.4 Menggunting fabrik pakaian sukan","4.5 Menjahit pakaian sukan.","4.6 Mengacu badan / Suai badan","4.7 Membuat kemasan akhir / kemas siapan."]]]],["","Menyenggara Mesin Jahit Khas",[["5.0 MENYENGGARA MESIN JAHIT KHAS",["5.1 Mengenal pasti mesin jahit khas.","5.2 Menyediakan bahan dan peralatan penyenggaraan mesin.","5.3 Menyenggara mesin."]]]]]}