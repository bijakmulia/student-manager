{"s":"KVS ASAS TANAMAN","f":"3","u":[["CU 3","3.0 OPERASI PENANAMAN BAHAN TANAMAN",[["3.1. Semai biji benih secara terus",["Pengetahuan","i. Pemilihan biji benih","· tujuan","· jenis","· ciri-ciri biji benih","· kuantiti","· sistem menanam","· kaedah menanam","ii. Rawatan biji benih","· Tujuan rawatan","· Bahan rawatan","· Kaedah rawatan","- Rendam","- gaul","iii. pelindung anak tanaman (sungkupan)","- tujuan","- jenis","- bahan dan peralatan","- kaedah","Amali","i. Dapatkan biji benih","ii. Rawat biji benih","iii. Tanam biji benih","iv. Pasang lindungan","v. siram biji benih"]],["3.2. Tanam anak pokok",["Pengetahuan","i. Faktor pemilihan anak pokok","· tujuan","· Ciri-ciri anak pokok","· Tahap kesuburan","· Keseragaman","ii. sistem penanaman anak pokok","· Empat segi sama","· Tiga segi","· Siku kluang","· Empat segi tepat","iii. kaedah penanaman","· saiz lubang","· baja asas","· masa menanam","· pelindung","· penyokong","· penyiraman","Amali","i. Pilih anak pokok","ii. Dapatkan peralatan","iii. tanda lubang tanaman","vi. pasang lindungan","v. tanam anak pokok","vii. pasang alat penyokong","ix. siram anak pokok"]],["3.3. Sulam anak pokok tanaman",["Pengetahuan","i. Sulaman anak tanaman","· Tujuan","· Kepentingan","· ciri-ciri pokok yang rosak","· kaedah","ii. pengrekodan penyulaman","· format","· kandungan","Amali","i. Kenalpasti jumlah anak pokok","ii. Dapatkan bahan sulaman tanaman","iii. tanam pokok pengganti","iv. rekod kerja penyulaman"]],["3.4. Buat penjarangan anak tanaman",["Pengetahuan","i. Kepentingan dan Tujuan penjarangan anak tanaman","· Kesuburan","· Keseragaman","ii. Jarak tanaman","· jenis tanaman","· manual tanaman","iii. Pelupusan sisa tanaman","· Jenis pelupusan","· Kaedah","· Bahan dan peralatan","Amali","i. Periksa anak tanaman","ii. Cabut anak tanaman","iii. lupus anak tanaman"]]]],["CU 6","6.0. OPERASI PENUAIAN HASIL TANAMAN",[["6.1 Tuai Hasil Tanaman",["Pengetahuan","i. Jenis tanaman","· Klimaterik","· Bukan klimaterik","ii. Indikator kematan